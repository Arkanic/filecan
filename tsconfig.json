{
    "compilerOptions": {
        "target": "es2025",
        "module": "commonjs",
        "allowJs": true,
        "resolveJsonModule": true,
        "sourceMap": false,
        "outDir": "./build",
        "rootDir": "./src",
        "strict": false,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "typeRoots": [
            "node_modules/@types"
        ]
    },
    "exclude": [
        "./node_modules",
        "./build",
        "./src/client"
    ],
    "include": [
        "./src/"
    ]
}